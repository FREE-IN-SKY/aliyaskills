#!/usr/bin/env bash
# Extract one task's full text and the plan's Global Constraints section into
# a file the implementer and reviewer read as their shared requirements.
#
# Usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]
# Default OUTFILE: <repo-root>/.superpowers/sdd/task-<N>-brief.md
# This stable task-scoped path supports resume. One SDD run owns a worktree.
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]" >&2
  exit 2
fi

plan=$1
n=$2
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }
[[ "$n" =~ ^[1-9][0-9]*$ ]] || {
  echo "task number must be a positive integer: $n" >&2
  exit 2
}

if [ $# -eq 3 ]; then
  out=$3
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace")
  out="$dir/task-${n}-brief.md"
fi

tmp=$(mktemp "${out}.tmp.XXXXXX")
trap 'rm -f "$tmp"' EXIT

awk -v n="$n" '
  function heading_level(line, prefix) {
    prefix = line
    sub(/[^#].*$/, "", prefix)
    return length(prefix)
  }

  function fence_info(line, text, char, i) {
    text = line
    sub(/^[ \t]*/, "", text)
    char = substr(text, 1, 1)
    if (char != "`" && char != "~") {
      return 0
    }
    i = 1
    while (substr(text, i, 1) == char) {
      i++
    }
    fencechar = char
    fencelen = i - 1
    fencerest = substr(text, i)
    return fencelen >= 3
  }

  {
    isfence = fence_info($0)
    if (isfence && !infence) {
      if (intask) task[++tasklines] = $0
      if (inglobal) global[++globallines] = $0
      infence = 1
      openfencechar = fencechar
      openfencelen = fencelen
      next
    }
    if (isfence && infence && fencechar == openfencechar &&
        fencelen >= openfencelen && fencerest ~ /^[ \t]*$/) {
      if (intask) task[++tasklines] = $0
      if (inglobal) global[++globallines] = $0
      infence = 0
      next
    }
  }

  !infence && /^#+[ \t]+/ {
    level = heading_level($0)
    istaskheading = ($0 ~ /^##[#]?[ \t]+Task[ \t]+[0-9]+([ \t]*:[ \t]*[^ \t].*)?[ \t]*$/)

    if ($0 ~ /^##[ \t]+Global Constraints[ \t]*$/) {
      globalcount++
      inglobal = 1
    } else if (inglobal && (level <= 2 || istaskheading)) {
      inglobal = 0
    }

    if (istaskheading) {
      intask = ($0 ~ ("^##[#]?[ \t]+Task[ \t]+" n "([ \t]*:[ \t]*[^ \t].*)?[ \t]*$"))
      if (intask) {
        taskcount++
        tasklevel = level
      }
    } else if (intask && level <= tasklevel) {
      intask = 0
    }
  }

  intask { task[++tasklines] = $0 }
  inglobal { global[++globallines] = $0 }

  END {
    if (infence) {
      print "plan contains an unclosed code fence" > "/dev/stderr"
      exit 3
    }
    if (taskcount == 0) {
      print "task " n " not found; use heading ### Task " n ": Name or ## Task " n > "/dev/stderr"
      exit 3
    }
    if (taskcount > 1) {
      print "task " n " appears more than once" > "/dev/stderr"
      exit 3
    }
    if (globalcount == 0) {
      print "Global Constraints not found; use exact heading ## Global Constraints" > "/dev/stderr"
      exit 3
    }
    if (globalcount > 1) {
      print "Global Constraints appears more than once" > "/dev/stderr"
      exit 3
    }

    for (i = 1; i <= tasklines; i++) {
      print task[i]
    }

    if (globallines) {
      print ""
      for (i = 1; i <= globallines; i++) {
        print global[i]
      }
    }
  }
' "$plan" > "$tmp"

[ -s "$tmp" ] || { echo "task ${n} produced an empty brief" >&2; exit 3; }
mv "$tmp" "$out"
trap - EXIT

echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines"
